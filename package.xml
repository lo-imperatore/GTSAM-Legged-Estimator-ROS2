<?xml version="1.0"?>
<package format="3">
  <name>gtsam_legged_replay_example</name>
  <version>0.1.0</version>
  <description>Minimal live ROS 2 runner for the GTSAM legged estimator.</description>
  <maintainer email="gch06208@snu.ac.kr">maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>builtin_interfaces</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>rosidl_typesupport_introspection_cpp</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rosidl_typesupport_cpp</exec_depend>
  <exec_depend>rosidl_typesupport_introspection_cpp</exec_depend>
  <exec_depend>spot_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
